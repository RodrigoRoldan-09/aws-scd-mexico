# AWS Student Community Day México
# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local al repo.

# Base de datos (MongoDB Atlas). Usa una base propia de México.
MONGODB_URI=

# Secreto para firmar las sesiones del panel. Genera uno nuevo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Dominio público, sin barra final. Se usa en correos, QR, SEO y remitente.
# Es NEXT_PUBLIC: se incrusta en el build, tiene que estar antes de `npm run build`.
NEXT_PUBLIC_APP_URL=https://scd-mexico.example

# AWS S3: uploads en runtime (fotos de speakers, slides, plantillas de PDF).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
# Opcional. Sólo si el bucket se comparte con otro país: todo va bajo "mx/...".
S3_PREFIX=

# Correo (Resend). El dominio del remitente tiene que estar verificado en Resend.
RESEND_API_KEY=
# Si se dejan vacíos se usa "AWS SCD <noreply@DOMINIO>".
EMAIL_FROM=
MARKETING_EMAIL_FROM=
# Firma de los webhooks de Resend (entregas y rebotes). Sin esto, /api/webhooks/resend responde 500.
RESEND_WEBHOOK_SECRET=

# Mapa estático de los correos (Google Static Maps). Opcional: sin él, el correo sale sin mapa.
GOOGLE_MAPS_KEY=

# Captcha (Cloudflare Turnstile). Sin la llave secreta, en desarrollo no se verifica.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Usuario admin inicial. Lo lee `npm run create-admin` (una sola vez).
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
